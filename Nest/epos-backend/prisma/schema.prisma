// ============================================================================
// Prisma Schema — E-POS AC
// SUMBER KEBENARAN: database Supabase (backend/supabase/migrations). File ini
// hasil `prisma db pull` dari Supabase local lalu dirapikan (nama model/field
// camelCase + @map). Perubahan skema dibuat sebagai migrasi SQL di
// backend/supabase/migrations — JANGAN `prisma migrate` ke database ini, dan
// 16 migrasi lama di prisma/migrations adalah riwayat DB Nest lama (arsip).
//
// Re-introspeksi: tambah sementara `schemas = ["public", "auth"]` (public.users
// ber-FK ke auth.users), pull, lalu buang lagi model auth.* — Nest tidak
// membaca skema internal Supabase lewat Prisma.
//
// Tidak dimodelkan di sini (tetap berlaku di DB):
// - unique index parsial cashier_shifts_one_open_per_kasir (kasir_id WHERE
//   closed_at IS NULL) — Prisma akan menganggapnya unik penuh (relasi 1:1).
// - RLS, trigger, function PL/pgSQL, FK public.users.id -> auth.users.id.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String               @id @default(uuid()) @db.Uuid
  email                   String
  displayName             String               @default("") @map("display_name")
  role                    UserRole             @default(kasir)
  active                  Boolean              @default(true)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  auditLogs               AuditLog[]
  cashierShifts           CashierShift[]
  deviceTokens            DeviceToken[]
  invoiceAdjustments      InvoiceAdjustment[]  @relation("AdjustmentCreatedBy")
  invoicesMade            Invoice[]            @relation("InvoiceCreatedBy")
  findingPhotosUploaded   JobFindingPhoto[]    @relation("FindingPhotoUploadedBy")
  findingsCreated         JobFinding[]         @relation("FindingCreatedBy")
  jobPhotosUploaded       JobPhoto[]           @relation("PhotoUploadedBy")
  manualPaymentsMade      ManualPayment[]      @relation("PaymentCreatedBy")
  materialRequestsBy      MaterialRequest[]    @relation("RequestCreatedBy")
  materialDecidedBy       MaterialRequest[]    @relation("RequestDecidedBy")
  materialUsedBy          MaterialRequest[]    @relation("RequestUsedBy")
  notifications           Notification[]
  reminderSettingsUpdated ReminderSetting[]    @relation("ReminderSettingUpdatedBy")
  serviceOrdersMade       ServiceOrder[]       @relation("ServiceOrderCreatedBy")
  stockMovementsMade      StockMovement[]      @relation("StockCreatedBy")
  jobsCreated             TechnicianJob[]      @relation("JobCreatedBy")
  technicianJobs          TechnicianJob[]      @relation("JobTechnician")
  transactionsMade        Transaction[]        @relation("TransactionCreatedBy")
  undianCreated           Undian[]
  vouchersCreated         Voucher[]            @relation("VoucherCreatedBy")
  waMessagesSent          WaOutbox[]
  waTemplatesUpdated      WaReminderTemplate[] @relation("WaTemplateUpdatedBy")

  @@map("users")
}

model AppConfig {
  key   String @id
  value String

  @@map("app_config")
}

model Counter {
  key String @id
  seq Int    @default(0)

  @@map("counters")
}

model AuditLog {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUid String?  @map("actor_uid") @db.Uuid
  action   String
  target   String?
  detail   Json?
  at       DateTime @default(now()) @db.Timestamptz(6)
  actor    User?    @relation(fields: [actorUid], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([at(sort: Desc)])
  @@map("audit_logs")
}

model DeviceToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String   @default("unknown")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "device_tokens_user_idx")
  @@map("device_tokens")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  body      String   @default("")
  type      String   @default("info")
  target    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "notifications_user_idx")
  @@map("notifications")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  brand       String
  type        String
  pk          Decimal  @default(0) @db.Decimal
  inverter    Boolean  @default(false)
  btu         Int?
  watt        Int?
  warranty    String?
  sellPrice   Int      @default(0) @map("sell_price")
  stock       Int      @default(0)
  photoUrl    String?  @map("photo_url")
  description String?
  category    String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sku         String?  @unique

  @@index([active])
  @@map("products")
}

model Sparepart {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  sku          String                    @default("")
  category     String
  unit         String
  sellPrice    Int                       @default(0) @map("sell_price")
  stock        Decimal                   @default(0) @db.Decimal
  minStock     Decimal                   @default(0) @map("min_stock") @db.Decimal
  active       Boolean                   @default(true)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  packageItems InstallationPackageItem[]

  @@index([active])
  @@map("spareparts")
}

model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  category        String
  basePrice       Int      @default(0) @map("base_price")
  durationMinutes Int?     @map("duration_minutes")
  description     String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([active])
  @@map("services")
}

model InstallationPackage {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  active      Boolean                   @default(true)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  items       InstallationPackageItem[]

  @@map("installation_packages")
}

model InstallationPackageItem {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId         String              @map("package_id") @db.Uuid
  sparepartId       String?             @map("sparepart_id") @db.Uuid
  name              String
  qty               Decimal             @default(0) @db.Decimal
  unit              String              @default("")
  extraPricePerUnit Int                 @default(0) @map("extra_price_per_unit")
  package           InstallationPackage @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sparepart         Sparepart?          @relation(fields: [sparepartId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([packageId], map: "installation_package_items_package_idx")
  @@map("installation_package_items")
}

model ItemCost {
  kind      ItemKind
  refId     String   @map("ref_id") @db.Uuid
  buyPrice  Int      @default(0) @map("buy_price")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([kind, refId])
  @@map("item_costs")
}

model Member {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  phone          String              @unique
  address        String              @default("")
  customerType   String              @default("lainnya") @map("customer_type")
  memberSince    DateTime?           @map("member_since") @db.Timestamptz(6)
  totalAcUnits   Int                 @default(0) @map("total_ac_units")
  notes          String?
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  waOptOut       Boolean             @default(false) @map("wa_opt_out")
  invoices       Invoice[]
  acUnits        MemberAcUnit[]
  serviceOrders  ServiceOrder[]
  technicianJobs TechnicianJob[]
  transactions   Transaction[]
  undianEntries  UndianParticipant[]
  vouchers       Voucher[]
  waMessages     WaOutbox[]

  @@map("members")
}

model MemberAcUnit {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId            String             @map("member_id") @db.Uuid
  brand               String
  model               String
  pk                  Decimal            @default(0) @db.Decimal
  roomLocation        String             @default("") @map("room_location")
  barcodeValue        String?            @unique @map("barcode_value")
  serialNumber        String?            @map("serial_number")
  installationDate    DateTime?          @map("installation_date") @db.Timestamptz(6)
  lastServiceDate     DateTime?          @map("last_service_date") @db.Timestamptz(6)
  nextServiceDate     DateTime?          @map("next_service_date") @db.Timestamptz(6)
  status              AcUnitStatus       @default(menunggu_pemasangan)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  serviceIntervalDays Int?               @map("service_interval_days")
  member              Member             @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  serviceOrderUnits   ServiceOrderUnit[]
  technicianJobs      TechnicianJob[]

  @@index([memberId])
  @@index([memberId], map: "member_ac_units_member_idx")
  @@map("member_ac_units")
}

model Transaction {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId       String?           @map("member_id") @db.Uuid
  customerName   String            @map("customer_name")
  customerPhone  String            @map("customer_phone")
  subtotal       Int               @default(0)
  discount       Int               @default(0)
  taxPercent     Decimal           @default(0) @map("tax_percent") @db.Decimal
  taxAmount      Int               @default(0) @map("tax_amount")
  transportFee   Int               @default(0) @map("transport_fee")
  grandTotal     Int               @default(0) @map("grand_total")
  notes          String?
  createdById    String?           @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  invoices       Invoice[]
  serviceOrders  ServiceOrder[]
  stockMovements StockMovement[]
  items          TransactionItem[]
  createdBy      User?             @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member         Member?           @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vouchersUsed   Voucher[]

  @@index([createdAt(sort: Desc)])
  @@index([memberId], map: "transactions_member_idx")
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String      @map("transaction_id") @db.Uuid
  kind          ItemKind
  refId         String      @map("ref_id") @db.Uuid
  name          String
  unit          String
  qty           Decimal     @db.Decimal
  unitPrice     Int         @map("unit_price")
  lineTotal     Int         @map("line_total")
  discount      Int         @default(0)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([transactionId], map: "transaction_items_transaction_idx")
  @@map("transaction_items")
}

model Invoice {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number           String              @unique
  transactionId    String?             @map("transaction_id") @db.Uuid
  memberId         String?             @map("member_id") @db.Uuid
  customerName     String              @map("customer_name")
  customerPhone    String              @map("customer_phone")
  subtotal         Int                 @default(0)
  discount         Int                 @default(0)
  taxPercent       Decimal             @default(0) @map("tax_percent") @db.Decimal
  taxAmount        Int                 @default(0) @map("tax_amount")
  transportFee     Int                 @default(0) @map("transport_fee")
  grandTotal       Int                 @default(0) @map("grand_total")
  totalPaid        Int                 @default(0) @map("total_paid")
  status           InvoiceStatus       @default(belum_dibayar)
  notes            String?
  createdById      String?             @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  adjustments      InvoiceAdjustment[]
  items            InvoiceItem[]
  createdBy        User?               @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member           Member?             @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction      Transaction?        @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manualPayments   ManualPayment[]
  materialRequests MaterialRequest[]
  serviceOrders    ServiceOrder[]

  @@index([createdAt(sort: Desc)])
  @@index([memberId], map: "invoices_member_idx")
  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  kind      ItemKind
  refId     String?  @map("ref_id") @db.Uuid
  name      String
  unit      String
  qty       Decimal  @db.Decimal
  unitPrice Int      @map("unit_price")
  lineTotal Int      @map("line_total")
  discount  Int      @default(0)
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invoiceId], map: "invoice_items_invoice_idx")
  @@map("invoice_items")
}

model InvoiceAdjustment {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId   String           @map("invoice_id") @db.Uuid
  requestId   String?          @map("request_id") @db.Uuid
  amount      Int
  reason      String           @default("pengajuan_tambahan")
  createdById String?          @map("created_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   User?            @relation("AdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice     Invoice          @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  request     MaterialRequest? @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invoiceId], map: "invoice_adjustments_invoice_idx")
  @@map("invoice_adjustments")
}

model ManualPayment {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId    String        @map("invoice_id") @db.Uuid
  method       PaymentMethod
  amount       Int
  note         String?
  proofUrl     String?       @map("proof_url")
  createdById  String?       @map("created_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  cashReceived Int?          @map("cash_received")
  shiftId      String?       @map("shift_id") @db.Uuid
  createdBy    User?         @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice      Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  shift        CashierShift? @relation(fields: [shiftId], references: [id], onUpdate: NoAction)

  @@index([invoiceId], map: "manual_payments_invoice_idx")
  @@index([shiftId], map: "manual_payments_shift_idx")
  @@map("manual_payments")
}

model CashierShift {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kasirId        String          @map("kasir_id") @db.Uuid
  openingBalance Int             @map("opening_balance")
  closingBalance Int?            @map("closing_balance")
  openedAt       DateTime        @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt       DateTime?       @map("closed_at") @db.Timestamptz(6)
  notes          String?
  kasir          User            @relation(fields: [kasirId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments       ManualPayment[]

  @@index([kasirId, openedAt(sort: Desc)], map: "cashier_shifts_kasir_idx")
  @@map("cashier_shifts")
}

model ServiceOrder {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId          String?            @map("member_id") @db.Uuid
  transactionId     String?            @map("transaction_id") @db.Uuid
  invoiceId         String?            @map("invoice_id") @db.Uuid
  type              String             @default("pemasangan")
  status            String             @default("terjadwal")
  createdById       String?            @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  note              String?
  scheduledDate     DateTime?          @map("scheduled_date") @db.Timestamptz(6)
  serviceOrderUnits ServiceOrderUnit[]
  createdBy         User?              @relation("ServiceOrderCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice           Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member            Member?            @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transaction       Transaction?       @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  units             TechnicianJob[]

  @@map("service_orders")
}

model ServiceOrderUnit {
  id      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String        @map("order_id") @db.Uuid
  unitId  String?       @map("unit_id") @db.Uuid
  status  String        @default("menunggu_pemasangan")
  order   ServiceOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  unit    MemberAcUnit? @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "service_order_units_order_idx")
  @@map("service_order_units")
}

model TechnicianJob {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String            @map("order_id") @db.Uuid
  memberId         String?           @map("member_id") @db.Uuid
  unitId           String?           @map("unit_id") @db.Uuid
  technicianId     String?           @map("technician_id") @db.Uuid
  type             String            @default("pemasangan")
  status           String            @default("menunggu_penugasan")
  scheduledDate    DateTime?         @map("scheduled_date") @db.Timestamptz(6)
  createdById      String?           @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  notes            String?
  startedAt        DateTime?         @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  reviewNote       String?           @map("review_note")
  findings         JobFinding[]
  photos           JobPhoto[]
  materialRequests MaterialRequest[]
  syncActions      SyncActionLog[]
  createdBy        User?             @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member           Member?           @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order            ServiceOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  technician       User?             @relation("JobTechnician", fields: [technicianId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unit             MemberAcUnit?     @relation(fields: [unitId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([memberId], map: "technician_jobs_member_idx")
  @@index([orderId], map: "technician_jobs_order_idx")
  @@index([technicianId], map: "technician_jobs_technician_idx")
  @@index([unitId], map: "technician_jobs_unit_idx")
  @@map("technician_jobs")
}

model JobPhoto {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String        @map("job_id") @db.Uuid
  kind         String
  path         String
  uploadedById String?       @map("uploaded_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  job          TechnicianJob @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploadedBy   User?         @relation("PhotoUploadedBy", fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([jobId], map: "job_photos_job_idx")
  @@index([jobId, kind], map: "job_photos_job_kind_idx")
  @@map("job_photos")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model ProblemCategory {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  source    String       @default("seed")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  findings  JobFinding[]

  @@map("problem_categories")
}

model JobFinding {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId       String            @map("job_id") @db.Uuid
  categoryId  String            @map("category_id") @db.Uuid
  title       String
  note        String?
  origin      String            @default("ditambah_teknisi")
  createdById String?           @map("created_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  photos      JobFindingPhoto[]
  category    ProblemCategory   @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User?             @relation("FindingCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  job         TechnicianJob     @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([jobId], map: "job_findings_job_idx")
  @@map("job_findings")
}

model JobFindingPhoto {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  findingId    String     @map("finding_id") @db.Uuid
  kind         String
  path         String
  uploadedById String?    @map("uploaded_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  finding      JobFinding @relation(fields: [findingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  uploadedBy   User?      @relation("FindingPhotoUploadedBy", fields: [uploadedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([findingId, kind], map: "job_finding_photos_finding_kind_idx")
  @@map("job_finding_photos")
}

model MaterialRequest {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId        String                @map("job_id") @db.Uuid
  invoiceId    String?               @map("invoice_id") @db.Uuid
  status       String                @default("pending")
  total        Int                   @default(0)
  note         String?
  decisionNote String?               @map("decision_note")
  createdById  String?               @map("created_by") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedById  String?               @map("decided_by") @db.Uuid
  decidedAt    DateTime?             @map("decided_at") @db.Timestamptz(6)
  usedAt       DateTime?             @map("used_at") @db.Timestamptz(6)
  usedById     String?               @map("used_by") @db.Uuid
  updatedAt    DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  adjustments  InvoiceAdjustment[]
  items        MaterialRequestItem[]
  createdBy    User?                 @relation("RequestCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decidedBy    User?                 @relation("RequestDecidedBy", fields: [decidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice      Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
