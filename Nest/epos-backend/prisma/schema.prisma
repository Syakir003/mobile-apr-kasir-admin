model Voucher {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String       @unique
  memberId            String       @map("member_id") @db.Uuid
  discountType        String       @map("discount_type")
  discountValue       Int          @map("discount_value")
  maxDiscountCap      Int?         @map("max_discount_cap")
  minPurchase         Int?         @map("min_purchase")
  expiresAt           DateTime     @map("expires_at") @db.Timestamptz(6)
  status              String       @default("aktif")
  source              String
  undianId            String?      @map("undian_id") @db.Uuid
  note                String?
  usedAt              DateTime?    @map("used_at") @db.Timestamptz(6)
  usedInTransactionId String?      @map("used_in_transaction_id") @db.Uuid
  createdById         String?      @map("created_by") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy           User?        @relation("VoucherCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  member              Member       @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  undian              Undian?      @relation(fields: [undianId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usedInTransaction   Transaction? @relation(fields: [usedInTransactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status])
  @@index([memberId], map: "vouchers_member_idx")
  @@map("vouchers")
}

