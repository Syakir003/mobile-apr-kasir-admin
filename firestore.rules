rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }

    match /users/{uid} {
      // Kasir perlu membaca users untuk dropdown teknisi di layar POS.
      allow read: if signedIn() &&
        (request.auth.uid == uid || role() == 'admin' || role() == 'kasir');
      allow write: if false;
    }

    match /products/{id} {
      allow read: if signedIn();
      allow write: if role() == 'admin';
    }
    match /spareparts/{id} {
      allow read: if signedIn();
      allow write: if role() == 'admin';
    }
    match /services/{id} {
      allow read: if signedIn();
      allow write: if role() == 'admin';
    }
    match /installation_packages/{id} {
      allow read: if signedIn();
      allow write: if role() == 'admin';
    }

    match /members/{id} {
      allow read: if signedIn();
      allow write: if role() == 'admin';
    }
    match /member_ac_units/{id} {
      allow read: if signedIn();
      allow write: if role() == 'admin';
    }

    // Counter barcode harian: hanya ditulis Cloud Functions (Admin SDK).
    match /counters/{id} {
      allow read, write: if false;
    }

    // Koleksi finansial & transaksi: ditulis HANYA oleh Cloud Functions
    // (checkoutTransaction, recordPayment). Client hanya membaca, terbatas
    // admin & kasir.
    match /transactions/{id} {
      allow read: if signedIn() && (role() == 'admin' || role() == 'kasir');
      allow write: if false;
      match /items/{itemId} {
        allow read: if signedIn() && (role() == 'admin' || role() == 'kasir');
        allow write: if false;
      }
    }
    match /invoices/{id} {
      allow read: if signedIn() && (role() == 'admin' || role() == 'kasir');
      allow write: if false;
    }
    match /manual_payments/{id} {
      allow read: if signedIn() && (role() == 'admin' || role() == 'kasir');
      allow write: if false;
    }
    match /stock_movements/{id} {
      allow read: if signedIn() && (role() == 'admin' || role() == 'kasir');
      allow write: if false;
    }

    // Order & job pemasangan: dibuat oleh checkoutTransaction. Fase 5 akan
    // memperketat akses tulis per teknisi.
    match /service_orders/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /technician_jobs/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
