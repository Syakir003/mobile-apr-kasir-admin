        <mxCell id="c5" value="Jenis item?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#a16207;fontColor=#422006;" vertex="1" parent="1">
          <mxGeometry x="355" y="245" width="250" height="104" as="geometry" />
