        <mxCell id="c19" value="Hapus data dalam satu transaksi:&lt;br&gt;lapis 1 transaksi dan histori bisnis&lt;br&gt;(semua scope), lapis berikutnya sesuai scope" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
