        <mxCell id="c2" value="Opname, koreksi stok, dan laporan stok per merk" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0f172a;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Opname produk AC per unit belum didukung (stok AC dihitung dari unit QR). Koreksi manual produk juga ditolak." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="48" width="1300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Gudang: hitung fisik (opname)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="360" y="132" width="240" height="60" as="geometry" />
