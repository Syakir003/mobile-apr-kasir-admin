        </mxCell>
        <mxCell id="c11" value="Tidak ada perubahan&lt;br&gt;(tetap dicatat di hasil)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#1e293b;" vertex="1" parent="1">
