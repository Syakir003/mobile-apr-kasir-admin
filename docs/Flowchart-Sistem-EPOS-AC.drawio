        <mxCell id="c8" value="Data lampau &quot;QR dulu&quot; (tipe belum diketahui):&lt;br&gt;status menunggu_data" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
