        <mxCell id="c2" value="Pembayaran, kirim invoice WhatsApp, dan shift kasir" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0f172a;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Tidak ada langkah verifikasi pembayaran terpisah: pembayaran yang dicatat kasir langsung berlaku. Shift hanya pencatatan kas, bukan syarat checkout." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="48" width="1300" height="40" as="geometry" />
