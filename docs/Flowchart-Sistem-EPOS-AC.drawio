        <mxCell id="c14" value="Koreksi manual (rusak, retur, koreksi, pembelian)&lt;br&gt;hanya sparepart. Produk AC ditolak.&lt;br&gt;Qty negatif = keluar (FIFO), positif = masuk" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#1e3a8a;align=left;spacing=8;" vertex="1" parent="1">
