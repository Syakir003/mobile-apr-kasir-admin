        </mxCell>
        <mxCell id="c3" value="Web dan mobile hanya bicara ke satu backend. Hanya backend yang menyentuh database dan layanan luar." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;" vertex="1" parent="1">
