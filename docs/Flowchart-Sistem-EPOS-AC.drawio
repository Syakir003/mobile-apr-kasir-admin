          <mxGeometry x="675" y="245" width="250" height="104" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Checkout dengan pemasangan:&lt;br&gt;status menunggu_pemasangan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="330" y="397" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Servis mandiri / data lampau (tipe diketahui):&lt;br&gt;status aktif" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
