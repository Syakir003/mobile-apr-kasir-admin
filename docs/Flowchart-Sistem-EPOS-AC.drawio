  <diagram id="p14" name="14 Administrasi">
    <mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="Administrasi: data lampau, pengguna, dan reset sistem" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0f172a;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Hanya admin. Tiga fitur yang mengubah banyak data sekaligus, jadi semuanya berjalan dalam satu transaksi dan tercatat di log audit." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="48" width="1300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Input Data Lampau (admin)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="40" y="132" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="Pilih/buat member lama,&lt;br&gt;isi unit AC, transaksi lampau (opsional)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="262" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Minimal 1 unit atau 1 transaksi?&lt;br&gt;Transaksi punya minimal 1 item?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#a16207;fontColor=#422006;" vertex="1" parent="1">
          <mxGeometry x="35" y="380" width="250" height="104" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Ditolak 400" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="360" y="400" width="240" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="Per unit: mode &quot;diketahui&quot; (aktif) atau&lt;br&gt;&quot;QR dulu&quot; (menunggu_data). Pengingat hanya&lt;br&gt;nyala bila diketahui dan siklus 7-730 hari" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="532" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Semua tersimpan dalam SATU transaksi:&lt;br&gt;gagal di tengah = tidak ada member setengah jadi" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="667" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Label QR unit dicetak lalu ditempel&lt;br&gt;(lihat halaman Unit AC)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="807" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="Kelola pengguna (admin)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="680" y="132" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="Buat akun (email, nama, peran: admin, kasir,&lt;br&gt;teknisi, gudang), nonaktifkan, reset password,&lt;br&gt;ubah nama atau peran" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="680" y="262" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="Menurunkan/menonaktifkan&lt;br&gt;admin aktif TERAKHIR atau diri sendiri?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#a16207;fontColor=#422006;" vertex="1" parent="1">
          <mxGeometry x="675" y="380" width="250" height="104" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="Ditolak 403&lt;br&gt;(agar tidak ada sistem tanpa admin)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="1000" y="400" width="240" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="Berlaku di request berikutnya&lt;br&gt;(role dibaca ulang dari database)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="680" y="532" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="Reset sistem (admin)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="1320" y="132" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="Teks konfirmasi&lt;br&gt;sama persis dengan yang diminta?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#a16207;fontColor=#422006;" vertex="1" parent="1">
          <mxGeometry x="1315" y="245" width="250" height="104" as="geometry" />
