        <mxCell id="c12" value="Stok disetel ke angka fisik,&lt;br&gt;mutasi stok &quot;opname&quot;, log audit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="970" y="802" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="Gudang yang input: admin dapat notifikasi&lt;br&gt;ringkasan selisih. Sparepart di bawah minimum:&lt;br&gt;admin dan gudang dapat notifikasi stok menipis" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
