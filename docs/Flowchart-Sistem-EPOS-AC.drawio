        <mxCell id="c9" value="Password cocok?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#a16207;fontColor=#422006;" vertex="1" parent="1">
          <mxGeometry x="35" y="515" width="250" height="104" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="Ditolak 401&lt;br&gt;&quot;Email atau password salah&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="360" y="535" width="240" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="Buat JWT: id user + role&lt;br&gt;berlaku 8 jam" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="667" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="Setiap request berikutnya:&lt;br&gt;cek akun masih aktif dan token terbit&lt;br&gt;SETELAH password terakhir diganti" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="802" width="240" height="70" as="geometry" />
