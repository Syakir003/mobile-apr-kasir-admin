        <mxCell id="c10" value="Selisih fisik vs sistem?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#a16207;fontColor=#422006;" vertex="1" parent="1">
