        <mxCell id="c9" value="Pilih gulungan (batch) yang dihitung,&lt;br&gt;isi angka fisik gulungan itu" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
