        <mxCell id="c2" value="Unit AC terpasang: data, scan teknisi, koreksi, dan label" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0f172a;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Satu unit terpasang = satu barcode, walau terdiri dari dua produk (Indoor dan Outdoor). Teknisi tidak boleh mengubah data unit aktif langsung." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;" vertex="1" parent="1">
