        <mxCell id="c8" value="Pilih sparepart, isi angka fisik" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="400" y="532" width="240" height="70" as="geometry" />
