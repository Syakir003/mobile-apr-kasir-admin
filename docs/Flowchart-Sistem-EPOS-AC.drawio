  <diagram id="p11" name="11 Pengingat WA">
    <mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="Pengingat servis otomatis lewat WhatsApp" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0f172a;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Berjalan tiap hari 09:00 WIB, bisa dipicu manual admin. Aman dijalankan berulang: kunci unik mencegah pesan dobel." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="48" width="1300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Cron 09:00 WIB&lt;br&gt;atau admin klik &quot;Jalankan sekarang&quot;" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="360" y="132" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="Cari unit AC yang memenuhi SEMUA syarat:&lt;br&gt;aktif, pengingat nyala, punya tanggal servis berikutnya,&lt;br&gt;member aktif dan tidak opt-out WA,&lt;br&gt;tidak punya job yang masih berjalan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="360" y="262" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Tanggal servis berikutnya jatuh pada?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#a16207;fontColor=#422006;" vertex="1" parent="1">
          <mxGeometry x="355" y="380" width="250" height="104" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Tepat 3 hari lagi:&lt;br&gt;jenis pesan reminder_h3" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="10" y="532" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="7 hari yang lalu (sudah lewat):&lt;br&gt;jenis pesan reminder_h7" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="660" y="532" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Kelompokkan: satu member dengan beberapa AC&lt;br&gt;yang jatuh tempo bersamaan menerima SATU pesan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="360" y="667" width="240" height="70" as="geometry" />
