        <mxCell id="c18" value="Ditolak 400&lt;br&gt;&quot;Teks konfirmasi salah&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#7f1d1d;" vertex="1" parent="1">
