  <diagram id="p2" name="02 Login dan keamanan">
    <mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c2" value="Login dan penjagaan setiap request" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#0f172a;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="12" width="1200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="Role dibaca ulang dari database di setiap request, bukan dipercaya dari isi token. Mengganti role atau menonaktifkan akun langsung berlaku." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#475569;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="48" width="1300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Pengguna isi email dan password" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#dcfce7;strokeColor=#15803d;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="40" y="132" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="Masih dalam batas percobaan?&lt;br&gt;10 per menit per IP+email,&lt;br&gt;40 per menit per IP" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#a16207;fontColor=#422006;" vertex="1" parent="1">
          <mxGeometry x="35" y="245" width="250" height="104" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Ditolak 429&lt;br&gt;terlalu banyak percobaan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fee2e2;strokeColor=#b91c1c;fontColor=#7f1d1d;" vertex="1" parent="1">
          <mxGeometry x="360" y="265" width="240" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Email ada dan akun aktif?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#fef9c3;strokeColor=#a16207;fontColor=#422006;" vertex="1" parent="1">
          <mxGeometry x="35" y="380" width="250" height="104" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="Tetap hitung bcrypt dengan hash palsu&lt;br&gt;agar waktu respons sama&lt;br&gt;(email tidak bisa ditebak)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#475569;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="360" y="397" width="240" height="70" as="geometry" />
